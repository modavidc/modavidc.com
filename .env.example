# Copia este archivo a .env y ajusta valores según tu server (Traefik externo).
# Ejemplo:
#   cp .env.example .env

##
## App / Docker
##

# Nombre del contenedor (opcional)
CONTAINER_NAME=modavidc-com

# Puerto interno donde Next escucha dentro del contenedor (no suele cambiarse)
SERVICE_PORT=3000

# Política de restart (prod)
RESTART_POLICY=always


##
## Traefik (stack externo)
##

# Dominio público del site (Traefik usa esto para Host())
DOMAIN=modavidc.com

# Habilitar/Deshabilitar routing por Traefik
TRAEFIK_ENABLE=true

# EntryPoint de Traefik (común: websecure)
TRAEFIK_ENTRYPOINT=websecure

# Cert resolver configurado en Traefik (p.ej. http-resolv)
TRAEFIK_CERTRESOLVER=http-resolv

# Dockerfile a usar (opcional; por defecto Dockerfile)
DOCKERFILE=Dockerfile
